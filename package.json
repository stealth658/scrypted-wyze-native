{
  "name": "@stealth658/scrypted-wyze-native",
  "version": "0.1.1",
  "description": "Wyze cameras in Scrypted with local P2P video (bundled go2rtc) and the cameras' own motion detection",
  "license": "MIT",
  "scripts": {
    "build": "scrypted-webpack",
    "prepublishOnly": "NODE_ENV=production scrypted-webpack",
    "scrypted-deploy": "scrypted-deploy",
    "scrypted-debug": "scrypted-debug",
    "scrypted-deploy-debug": "scrypted-deploy-debug"
  },
  "keywords": [
    "scrypted",
    "plugin",
    "wyze",
    "go2rtc",
    "camera"
  ],
  "scrypted": {
    "rollup": true,
    "name": "Wyze Native",
    "type": "DeviceProvider",
    "interfaces": [
      "DeviceProvider",
      "Settings"
    ],
    "pluginDependencies": [
      "@scrypted/prebuffer-mixin"
    ]
  },
  "devDependencies": {
    "@scrypted/sdk": "0.5.59",
    "@types/node": "^22.0.0"
  }
}
